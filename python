import sys
import io
import time
import html as _html

import fitz  # PyMuPDF
from deep_translator import GoogleTranslator

PDF_ENTRADA = "W40K.pdf"
PDF_SAIDA = "arquivo_traduzido.pdf"

TAMANHO_BLOCO = 4000
MAX_TENTATIVAS = 3
PAUSA_ENTRE_REQUISICOES = 0.5


def dividir_texto(texto, tamanho=TAMANHO_BLOCO):
    blocos = []
    inicio = 0
    total = len(texto)
    while inicio < total:
        fim = min(inicio + tamanho, total)
        if fim < total:
            corte = texto.rfind("\n", inicio, fim)
            if corte == -1 or corte <= inicio:
                corte = texto.rfind(" ", inicio, fim)
            if corte != -1 and corte > inicio:
                fim = corte
        blocos.append(texto[inicio:fim])
        inicio = fim
    return blocos


def traduzir_bloco(bloco, tentativas=MAX_TENTATIVAS):
    for tentativa in range(1, tentativas + 1):
        try:
            resultado = GoogleTranslator(source="auto", target="pt").translate(bloco)
            return resultado if resultado else bloco
        except Exception as erro:
            if tentativa == tentativas:
                print(f"  Erro definitivo: {erro}. Mantendo original.")
                return bloco
            espera = 2 ** (tentativa - 1)
            print(f"  Tentativa {tentativa}/{tentativas} falhou. Aguardando {espera}s...")
            time.sleep(espera)


def traduzir_texto(texto):
    if not texto.strip():
        return texto
    partes = dividir_texto(texto)
    resultado = []
    for i, parte in enumerate(partes, start=1):
        if not parte.strip():
            resultado.append(parte)
            continue
        print(f"    Bloco {i}/{len(partes)}...")
        traducao = traduzir_bloco(parte)
        resultado.append(traducao)
        time.sleep(PAUSA_ENTRE_REQUISICOES)
    return " ".join(resultado)


def cor_media_area(page, rect):
    """
    Pega a cor de fundo dominante na area do bloco de texto
    amostrando um retangulo pequeno ao redor do texto.
    Retorna (r, g, b) em escala 0-1.
    """
    try:
        clip = fitz.Rect(rect.x0, rect.y0, rect.x0 + 20, rect.y0 + 10)
        clip = clip & page.rect  # garante que esta dentro da pagina
        if clip.is_empty:
            return (1, 1, 1)
        pix = page.get_pixmap(clip=clip, matrix=fitz.Matrix(1, 1))
        samples = pix.samples
        if len(samples) >= 3:
            r = samples[0] / 255
            g = samples[1] / 255
            b = samples[2] / 255
            return (r, g, b)
    except Exception:
        pass
    return (1, 1, 1)


def luminancia(cor):
    return 0.299 * cor[0] + 0.587 * cor[1] + 0.114 * cor[2]


def main():
    print(f"Abrindo: {PDF_ENTRADA}")
    doc = fitz.open(PDF_ENTRADA)
    total = len(doc)

    for num, page in enumerate(doc, start=1):
        print(f"\nPagina {num}/{total}...")

        # Pega todos os blocos de texto com posicao
        blocos = page.get_text("dict", flags=fitz.TEXT_PRESERVE_WHITESPACE)["blocks"]

        for bloco in blocos:
            if bloco.get("type") != 0:  # 0 = texto, 1 = imagem
                continue

            rect = fitz.Rect(bloco["bbox"])

            # Junta todo o texto do bloco
            texto_original = ""
            tamanho_fonte = 11
            nome_fonte = "helv"

            for linha in bloco.get("lines", []):
                for span in linha.get("spans", []):
                    texto_original += span.get("text", "")
                    tamanho_fonte = span.get("size", 11)
                    # Tenta manter a fonte original; cai de volta para helvetica se nao disponivel
                    nome_fonte = span.get("font", "helv")

            if not texto_original.strip():
                continue

            # Traduz
            print(f"  Traduzindo: {texto_original[:60].strip()}...")
            texto_traduzido = traduzir_texto(texto_original)

            # Detecta cor de fundo da area
            cor_fundo = cor_media_area(page, rect)
            lum = luminancia(cor_fundo)
            cor_texto = (0, 0, 0) if lum > 0.5 else (1, 1, 1)

            # Apaga o texto original pintando o retangulo com a cor de fundo
            shape = page.new_shape()
            shape.draw_rect(rect)
            shape.finish(fill=cor_fundo, color=cor_fundo, width=0)
            shape.commit()

            # Escreve o texto traduzido na mesma area
            # Limita o tamanho da fonte para caber no espaco
            fonte_final = min(tamanho_fonte, 11)

            try:
                page.insert_textbox(
                    rect,
                    texto_traduzido,
                    fontsize=fonte_final,
                    color=cor_texto,
                    align=0,  # esquerda
                    overlay=True,
                )
            except Exception as e:
                print(f"    Aviso ao inserir texto: {e}")
                # Tenta com fonte menor se nao couber
                try:
                    page.insert_textbox(
                        rect,
                        texto_traduzido,
                        fontsize=max(6, fonte_final - 2),
                        color=cor_texto,
                        align=0,
                        overlay=True,
                    )
                except Exception:
                    pass

    print(f"\nSalvando {PDF_SAIDA}...")
    doc.save(PDF_SAIDA, garbage=4, deflate=True)
    doc.close()
    print(f"Concluido! Arquivo: {PDF_SAIDA}")


if __name__ == "__main__":
    main()
